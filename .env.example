# Development only: copy to .env.development, or run pnpm local:config.
# pnpm dev never reads .env or .env.production and rejects remote DB/Redis.
# Production: see .env.production.example; configure Railway variables separately.
DATABASE_URL=postgresql://tableapp:tableapp@localhost:5432/tableapp
# Neon writes a pooled DATABASE_URL plus a direct DATABASE_URL_UNPOOLED.
# Migrations and schema tooling use the direct endpoint when it is present.
# DATABASE_URL_UNPOOLED=
PORT=3001
# Optional Node-only: built SPA served on the API origin; empty = API-only.
# CLIENT_DIST_PATH=/absolute/path/to/apps/client/dist
# HOST=127.0.0.1 # bind locally when using the local Node deployment
APP_URL=http://localhost:5173

# Production worker Compose contract + smoke checklist: docs/workers.md
# Host environment/--env-file supplies Compose interpolation; it is not baked into images.
# Better Auth: BETTER_AUTH_SECRET is required even for workers (auth import chain).
BETTER_AUTH_SECRET=replace-with-32+-char-secret
BETTER_AUTH_URL=http://localhost:3001
# AUTH_REQUIRED=true   # enforce login on /api/commands

# Resend (member invites). Without key, invite links are logged to server console.
RESEND_API_KEY=
EMAIL_FROM=tabdo <onboarding@resend.dev>

# Native HarnessAgent — select harness/runtime/model in agent setup (no Assistant Cloud)
OPENAI_API_KEY=
# CODEX_API_KEY=
# CODEX_MODEL=  # omitted = native Codex default
# OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# CLAUDE_MODEL= # omitted = native Claude Code default
# ANTHROPIC_BASE_URL=

# Pi = OpenAI-compatible endpoint (Pi gateway OR OpenRouter)
PI_API_KEY=
PI_BASE_URL=
# PI_MODEL=     # required for custom Pi unless configured on the agent
# PI_THINKING_LEVEL=medium # off|minimal|low|medium|high|xhigh|max; capable models default to native medium
# Custom Pi endpoints: configure the model's real limits (defaults: 32768 / 8192).
# OpenRouter context/provider limits are read from its /models catalog.
# PI_CONTEXT_WINDOW=32768
# PI_MAX_OUTPUT_TOKENS=16384 # total completion budget; still capped by the model catalog

# Shortcut: OpenRouter alone (maps to Pi harness)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free

# Remote Vercel Sandbox (required for Codex/Claude Code; optional for Pi)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# VERCEL_OIDC_TOKEN= # deployment OIDC can replace the three values above

# Native turns finish naturally; a step cap is optional and suspends the SDK turn.
# SDK lifecycle/stream events drive external AbortSignal deadlines.
# AI_CHAT_MAX_STEPS=32
# AI_CHAT_TOTAL_MS=300000
# AI_CHAT_STEP_MS=90000
# AI_CHAT_FIRST_CHUNK_MS=45000
# AI_CHAT_CHUNK_MS=30000
AI_RUN_POLL_MS=2000

# Redis/BullMQ. Match triggers/conditions in the write transaction; relay atomically claims matched outbox records.
REDIS_URL=redis://127.0.0.1:6380
QUEUE_PREFIX=tabdo-development
DB_POOL_MAX=10
# Compose uses container-network defaults; override for external PG/Redis:
# QUEUE_DATABASE_URL=postgresql://user:password@database:5432/tableapp
# QUEUE_REDIS_URL=redis://redis:6379
# Worker pool starts at 4; budget API + worker connections across ALL replicas.
WORKER_CONCURRENCY=8
QUEUE_GLOBAL_CONCURRENCY=32
AUTOMATION_TENANT_CONCURRENCY=4
AUTOMATION_ATTEMPTS=5
AUTOMATION_RELAY_BATCH=25
AUTOMATION_RELAY_LEASE_MS=30000
# Startup + low-frequency safety recovery; normal dispatch is Redis-driven.
# Keep > 5 minutes to allow an idle Neon database to suspend.
AUTOMATION_RECOVERY_INTERVAL_MS=900000
WORKER_SHUTDOWN_MS=20000

# Uploaded file storage (local by default; generated IDs, no public static directory)
FILE_STORAGE_DRIVER=local
# FILE_STORAGE_LOCAL_DIR=/absolute/path/to/data/files # default: repo data/files
# FILE_UPLOAD_MAX_BYTES=26214400 # 25 MiB per file
# FILE_UPLOAD_MAX_FILES=20
# FILE_UPLOAD_MAX_REQUEST_BYTES=104857600 # 100 MiB total request, including multipart overhead
# S3-compatible storage. Provision the bucket first; no public bucket is needed.
# FILE_STORAGE_S3_ENDPOINT=http://localhost:9000
# FILE_STORAGE_S3_REGION=us-east-1
# FILE_STORAGE_S3_BUCKET=tabdo-files
# Optional pair; omit both to use the official AWS credential chain (e.g. IAM role).
# FILE_STORAGE_S3_ACCESS_KEY_ID=
# FILE_STORAGE_S3_SECRET_ACCESS_KEY=
# FILE_STORAGE_S3_FORCE_PATH_STYLE=true
# Neon Object Storage (neon deploy) injects the AWS-standard names instead:
# AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
# They are used as a fallback, so FILE_STORAGE_DRIVER=s3 needs only the bucket.

# Service integration secrets (AES-256-GCM). Required to save/use AgentMail credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this stable across API/worker replicas; changing it does not migrate ciphertext.
INTEGRATION_ENCRYPTION_KEY=
# Public base URL for incoming hooks, without /api/webhooks. Use a stable HTTPS origin
# reachable by AgentMail; local development can use an explicitly configured tunnel.
# WEBHOOK_PUBLIC_URL=https://your-tabdo.example.com
# WEBHOOK_MAX_BODY_BYTES=2097152 # default 2 MiB; min 1 KiB, max 16 MiB
