DATABASE_URL=postgresql://tableapp:tableapp@localhost:5432/tableapp
PORT=3001
APP_URL=http://localhost:5173

# Better Auth
BETTER_AUTH_SECRET=replace-with-32+-char-secret
BETTER_AUTH_URL=http://localhost:3001
# AUTH_REQUIRED=true   # enforce login on /api/commands

# Resend (member invites). Without key, invite links are logged to server console.
RESEND_API_KEY=
EMAIL_FROM=Agrid <onboarding@resend.dev>

# Multi-harness (no Assistant Cloud) — pick in chat UI / agent setup
OPENAI_API_KEY=
# CODEX_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Pi = OpenAI-compatible endpoint (Pi gateway OR OpenRouter)
PI_API_KEY=
PI_BASE_URL=
# PI_MODEL=openrouter/free
# PI_MODELS=openrouter/free|OpenRouter Free,openrouter/auto|OpenRouter Auto

# Shortcut: OpenRouter alone (maps to Pi harness)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
