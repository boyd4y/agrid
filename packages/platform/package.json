{
  "name": "@tabdo/platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/db/factory.d.ts",
      "development": "./src/db/factory.ts",
      "import": "./dist/db/factory.js",
      "default": "./dist/db/factory.js"
    },
    "./auth": {
      "types": "./dist/auth/factory.d.ts",
      "development": "./src/auth/factory.ts",
      "import": "./dist/auth/factory.js",
      "default": "./dist/auth/factory.js"
    },
    "./schema": {
      "types": "./dist/db/schema.d.ts",
      "development": "./src/db/schema.ts",
      "import": "./dist/db/schema.js",
      "default": "./dist/db/schema.js"
    },
    "./checkpoints": {
      "types": "./dist/agent/checkpoints.d.ts",
      "development": "./src/agent/checkpoints.ts",
      "import": "./dist/agent/checkpoints.js",
      "default": "./dist/agent/checkpoints.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tabdo/shared": "workspace:*",
    "better-auth": "^1.7.7",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3"
  }
}
