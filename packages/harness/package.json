{
  "name": "@tabdo/harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "development": "./src/agent.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    "./adapters/pi": {
      "types": "./dist/adapters/pi.d.ts",
      "development": "./src/adapters/pi.ts",
      "import": "./dist/adapters/pi.js",
      "default": "./dist/adapters/pi.js"
    },
    "./adapters/codex": {
      "types": "./dist/adapters/codex.d.ts",
      "development": "./src/adapters/codex.ts",
      "import": "./dist/adapters/codex.js",
      "default": "./dist/adapters/codex.js"
    },
    "./adapters/claude-code": {
      "types": "./dist/adapters/claude-code.d.ts",
      "development": "./src/adapters/claude-code.ts",
      "import": "./dist/adapters/claude-code.js",
      "default": "./dist/adapters/claude-code.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "pnpm build && tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@ai-sdk/harness": "1.0.149",
    "@ai-sdk/harness-pi": "1.0.151",
    "@ai-sdk/harness-codex": "1.0.151",
    "@ai-sdk/harness-claude-code": "1.0.153",
    "ai": "^7.0.138"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/harness-pi": {
      "optional": true
    },
    "@ai-sdk/harness-codex": {
      "optional": true
    },
    "@ai-sdk/harness-claude-code": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3",
    "tsx": "^4.19.3",
    "@ai-sdk/harness": "1.0.149",
    "@ai-sdk/harness-pi": "1.0.151",
    "@ai-sdk/harness-codex": "1.0.151",
    "@ai-sdk/harness-claude-code": "1.0.153",
    "ai": "^7.0.138",
    "@tabdo/sandbox": "workspace:*",
    "just-bash": "2.14.5"
  }
}
