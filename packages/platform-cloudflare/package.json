{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "name": "@tabdo/platform-cloudflare",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "workerd": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./queue": {
      "types": "./src/queue/index.ts",
      "workerd": "./src/queue/index.ts",
      "development": "./src/queue/index.ts",
      "import": "./dist/queue/index.js",
      "default": "./dist/queue/index.js"
    },
    "./storage/r2": {
      "types": "./src/storage/r2.ts",
      "workerd": "./src/storage/r2.ts",
      "development": "./src/storage/r2.ts",
      "import": "./dist/storage/r2.js",
      "default": "./dist/storage/r2.js"
    },
    "./coordination/contracts": {
      "types": "./src/coordination/contracts.ts",
      "workerd": "./src/coordination/contracts.ts",
      "development": "./src/coordination/contracts.ts",
      "import": "./dist/coordination/contracts.js",
      "default": "./dist/coordination/contracts.js"
    },
    "./coordination/coordinator": {
      "types": "./src/coordination/coordinator.ts",
      "workerd": "./src/coordination/coordinator.ts",
      "development": "./src/coordination/coordinator.ts",
      "import": "./dist/coordination/coordinator.js",
      "default": "./dist/coordination/coordinator.js"
    },
    "./triggers": {
      "types": "./src/triggers.ts",
      "workerd": "./src/triggers.ts",
      "development": "./src/triggers.ts",
      "import": "./dist/triggers.js",
      "default": "./dist/triggers.js"
    },
    "./internal-auth": {
      "types": "./src/internal-auth.ts",
      "workerd": "./src/internal-auth.ts",
      "development": "./src/internal-auth.ts",
      "import": "./dist/internal-auth.js",
      "default": "./dist/internal-auth.js"
    },
    "./execution/container": {
      "types": "./src/execution/container.ts",
      "workerd": "./src/execution/container.ts",
      "development": "./src/execution/container.ts",
      "import": "./dist/execution/container.js",
      "default": "./dist/execution/container.js"
    },
    "./execution/container-object": {
      "types": "./src/execution/container-object.ts",
      "workerd": "./src/execution/container-object.ts",
      "development": "./src/execution/container-object.ts",
      "import": "./dist/execution/container-object.js",
      "default": "./dist/execution/container-object.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:container": "tsx --test test/container-execution/local.test.ts",
    "typecheck:container": "tsc -p test/fixture/container-execution/tsconfig.worker.json",
    "types:container": "wrangler types test/fixture/container-execution/env.d.ts --config test/fixture/container-execution/wrangler.jsonc --env-interface ContainerFixtureEnv --include-runtime=false"
  },
  "dependencies": {
    "@tabdo/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "4.149.0",
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "^22.14.1",
    "tsx": "^4.19.3"
  }
}
