{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "tabdo-queue-contract-fixture",
  "main": "worker.ts",
  // Highest date supported by the pinned local workerd binary.
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "RECEIPTS", "bucket_name": "tabdo-queue-test-receipts" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "tabdo-generic-test-jobs" }],
    "consumers": [{ "queue": "tabdo-generic-test-jobs", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "retry_delay": 1 }]
  }
}
