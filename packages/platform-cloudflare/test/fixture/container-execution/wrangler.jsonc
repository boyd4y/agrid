{
  "name": "generic-container-control-fixture",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "containers": [{
    "class_name": "ControlledContainer",
    "scheduling_policy": "durable_object",
    "images": { "runner": { "dockerfile": "Dockerfile", "build_context": "." } }
  },{
    "class_name": "InvalidProgramContainer",
    "scheduling_policy": "durable_object",
    "images": { "runner": { "dockerfile": "Dockerfile", "build_context": "." } }
  },{
    "class_name": "UnavailableImageContainer",
    "scheduling_policy": "durable_object",
    "images": { "runner": { "dockerfile": "Dockerfile", "build_context": "." } }
  }],
  "durable_objects": { "bindings": [
    { "name": "EXECUTIONS", "class_name": "ControlledContainer" },
    { "name": "INVALID_EXECUTIONS", "class_name": "InvalidProgramContainer" },
    { "name": "UNAVAILABLE_EXECUTIONS", "class_name": "UnavailableImageContainer" }
  ] },
  "exports": {
    "ControlledContainer": { "type": "durable-object", "storage": "sqlite" },
    "InvalidProgramContainer": { "type": "durable-object", "storage": "sqlite" },
    "UnavailableImageContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "r2_buckets": [{ "binding": "ACCEPTED", "bucket_name": "generic-container-accepted-fixture" }]
}
