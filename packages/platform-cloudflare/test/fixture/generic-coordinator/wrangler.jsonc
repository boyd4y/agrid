{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "generic-mailbox-coordination-fixture",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "MAILBOX_COORDINATORS", "class_name": "MailboxCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailboxCoordinator"] }],
  "r2_buckets": [{ "binding": "PACKET_ARCHIVE", "bucket_name": "generic-mailbox-packet-fixture" }]
}
