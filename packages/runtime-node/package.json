{
  "name": "@tabdo/runtime-node",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./queue": {
      "types": "./dist/queue.d.ts",
      "development": "./src/queue.ts",
      "import": "./dist/queue.js",
      "default": "./dist/queue.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "development": "./src/storage.ts",
      "import": "./dist/storage.js",
      "default": "./dist/storage.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@tabdo/core": "workspace:*",
    "@aws-sdk/client-s3": "^3.1150.0",
    "bullmq": "5",
    "ioredis": "5"
  }
}
