{
  "name": "@tabdo/sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/local": {
      "types": "./dist/adapters/local.d.ts",
      "development": "./src/adapters/local.ts",
      "import": "./dist/adapters/local.js",
      "default": "./dist/adapters/local.js"
    },
    "./adapters/vercel": {
      "types": "./dist/adapters/vercel.d.ts",
      "development": "./src/adapters/vercel.ts",
      "import": "./dist/adapters/vercel.js",
      "default": "./dist/adapters/vercel.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "pnpm build && tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@ai-sdk/harness": "1.0.149",
    "@ai-sdk/sandbox-just-bash": "1.0.149",
    "@ai-sdk/sandbox-vercel": "1.0.149",
    "just-bash": "2.14.5"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/sandbox-just-bash": {
      "optional": true
    },
    "@ai-sdk/sandbox-vercel": {
      "optional": true
    },
    "just-bash": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3",
    "tsx": "^4.19.3",
    "@ai-sdk/harness": "1.0.149",
    "@ai-sdk/sandbox-just-bash": "1.0.149",
    "@ai-sdk/sandbox-vercel": "1.0.149",
    "just-bash": "2.14.5"
  }
}
