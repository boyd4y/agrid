{
  "name": "@tabdo/execution",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/node-process": {
      "types": "./dist/adapters/node-process.d.ts",
      "development": "./src/adapters/node-process.ts",
      "import": "./dist/adapters/node-process.js",
      "default": "./dist/adapters/node-process.js"
    },
    "./adapters/node-worker": {
      "types": "./dist/adapters/node-worker.d.ts",
      "development": "./src/adapters/node-worker.ts",
      "import": "./dist/adapters/node-worker.js",
      "default": "./dist/adapters/node-worker.js"
    },
    "./internal-auth": {
      "types": "./dist/internal-auth.d.ts",
      "development": "./src/internal-auth.ts",
      "import": "./dist/internal-auth.js",
      "default": "./dist/internal-auth.js"
    },
    "./transport/http-host": {
      "types": "./dist/transport/http-host.d.ts",
      "development": "./src/transport/http-host.ts",
      "import": "./dist/transport/http-host.js",
      "default": "./dist/transport/http-host.js"
    },
    "./adapters/http": {
      "types": "./dist/adapters/http.d.ts",
      "development": "./src/adapters/http.ts",
      "import": "./dist/adapters/http.js",
      "default": "./dist/adapters/http.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "pnpm build && tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3",
    "tsx": "^4.19.3"
  }
}
