{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "name": "@tabdo/core",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./queue": {
      "types": "./src/queue/index.ts",
      "development": "./src/queue/index.ts",
      "import": "./dist/queue/index.js",
      "default": "./dist/queue/index.js"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "development": "./src/storage/index.ts",
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./execution": {
      "types": "./src/execution/index.ts",
      "development": "./src/execution/index.ts",
      "import": "./dist/execution/index.js",
      "default": "./dist/execution/index.js"
    },
    "./execution/http": {
      "types": "./src/execution/http.ts",
      "development": "./src/execution/http.ts",
      "import": "./dist/execution/http.js",
      "default": "./dist/execution/http.js"
    },
    "./internal-auth": {
      "types": "./src/internal-auth.ts",
      "development": "./src/internal-auth.ts",
      "import": "./dist/internal-auth.js",
      "default": "./dist/internal-auth.js"
    },
    "./transport/execution-http-host": {
      "types": "./src/transport/execution-http-host.ts",
      "development": "./src/transport/execution-http-host.ts",
      "import": "./dist/transport/execution-http-host.js",
      "default": "./dist/transport/execution-http-host.js"
    },
    "./harness": {
      "types": "./src/harness/index.ts",
      "development": "./src/harness/index.ts",
      "import": "./dist/harness/index.js",
      "default": "./dist/harness/index.js"
    },
    "./sandbox": {
      "types": "./src/sandbox/index.ts",
      "development": "./src/sandbox/index.ts",
      "import": "./dist/sandbox/index.js",
      "default": "./dist/sandbox/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsx": "^4.19.3",
    "@types/node": "^22.14.1"
