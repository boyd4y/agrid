{
  "name": "feishu-notion-table",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed",
    "setup": "pnpm install && pnpm db:migrate && pnpm db:seed",
    "db:seed:large": "pnpm --filter server db:seed:large",
    "db:smoke:perf": "pnpm --filter server db:smoke:perf",
    "db:seed:demo": "pnpm --filter server db:seed:demo",
    "db:seed:formula": "pnpm --filter server exec tsx src/db/seed-formula.ts",
    "db:smoke:formula": "pnpm --filter server exec tsx src/db/smoke-formula.ts",
    "mcp": "pnpm --filter @table/mcp start"
  },
  "packageManager": "pnpm@9.15.0"
}
