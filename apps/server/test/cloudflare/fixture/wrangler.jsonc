{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "tabdo-platform-factories-fixture",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "hyperdrive": [{
    "binding": "HYPERDRIVE",
    "id": "00000000000000000000000000000000",
    "localConnectionString": "postgresql://tableapp:tableapp@127.0.0.1:5432/tabdo_agent_test"
  }],
  "vars": { "AUTH_SECRET_ONE": "fixture-one-explicit-signing-secret-12345", "AUTH_SECRET_TWO": "fixture-two-independent-signing-secret-67890" }
}
