{
  "name": "@tabdo/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-env.mjs development tsx src/dev.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "db:generate": "node ../../scripts/run-env.mjs development drizzle-kit generate",
    "db:migrate": "node ../../scripts/run-env.mjs development tsx src/db/migrate.ts",
    "db:seed": "node ../../scripts/run-env.mjs development tsx src/db/seed-demo.ts",
    "db:seed:large": "node ../../scripts/run-env.mjs development tsx src/db/seed-large.ts",
    "db:smoke:perf": "node ../../scripts/run-env.mjs development tsx src/db/smoke-perf.ts",
    "db:seed:demo": "node ../../scripts/run-env.mjs development tsx src/db/seed-demo.ts",
    "db:seed:tenants": "node ../../scripts/run-env.mjs development tsx src/db/seed-tenants.ts",
    "queue:status": "tsx src/queue/status.ts",
    "test:queue": "tsx --test test/queue/queue.test.ts",
    "test:queue:events": "tsx --test test/queue/event-driven.test.ts",
    "dev:api": "pnpm -r --filter @tabdo/queue --filter @tabdo/worker --filter @tabdo/storage --filter @tabdo/agent-runtime --filter @tabdo/core --filter @tabdo/auth --filter @tabdo/db --filter @tabdo/shared build && node ../../scripts/run-env.mjs development tsx src/dev.ts --api-only",
    "test:queue:load": "tsx test/queue/load.ts",
    "queue:dev": "node ../../scripts/run-env.mjs development tsx watch --conditions=development --include '../../packages/shared/src/**/*.ts' --include '../../packages/queue/src/**/*.ts' --include '../../packages/worker/src/**/*.ts' --include '../../packages/storage/src/**/*.ts' --include '../../packages/agent-runtime/src/**/*.ts' --include '../../packages/core/src/**/*.ts' --include '../../packages/auth/src/**/*.ts' --include '../../packages/db/src/**/*.ts' src/queue/main.ts",
    "queue:start": "node dist/queue/main.js",
    "test:chat": "tsx --test test/ai/errors.test.ts test/routes/chat.test.ts",
    "test:relations": "tsx --test test/commands/relations.test.ts",
    "test:reports": "tsx --test test/reports/reports.test.ts",
    "test:harness": "tsc --project tsconfig.test.json && tsx --test test/harness/*.test.ts",
    "test:harness:remote": "tsx test/harness/remote-smoke.ts",
    "test:skills": "tsx --test test/skills/*.test.ts",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "test": "pnpm typecheck:test && tsx --test test/automation/*.test.ts test/ai/*.test.ts test/commands/*.test.ts test/reports/*.test.ts test/skills/*.test.ts test/harness/*.test.ts test/storage/*.test.ts test/routes/*.test.ts test/runner/*.test.ts",
    "test:automations": "tsx --test test/automation/*.test.ts",
    "test:runner": "tsx --test test/runner/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/harness": "1.0.152",
    "@ai-sdk/harness-claude-code": "1.0.156",
    "@ai-sdk/harness-codex": "1.0.154",
    "@ai-sdk/harness-pi": "1.0.154",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/sandbox-vercel": "1.0.152",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@hono/node-server": "^1.14.1",
    "@tabdo/shared": "workspace:*",
    "ai": "7.0.141",
    "better-auth": "^1.7.7",
    "cron-parser": "^5.6.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.8",
    "postgres": "^3.4.5",
    "resend": "^6.32.1",
    "svix": "^2.8.0",
    "yaml": "^2.8.1",
    "zod": "^4.6.5",
    "@tabdo/agent-runtime": "workspace:*",
    "@tabdo/queue": "workspace:*",
    "@tabdo/storage": "workspace:*",
    "@tabdo/core": "workspace:*",
    "@tabdo/auth": "workspace:*",
    "@tabdo/db": "workspace:*",
    "@tabdo/worker": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
