{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tabdo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://localhost:5173",
    "BETTER_AUTH_URL": "http://localhost:5173",
    "GATEWAY_ORIGIN": "http://host.docker.internal:8787"
  },
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tabdo-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "tabdo-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "tabdo-jobs",
        "max_batch_size": 8,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 10,
        "dead_letter_queue": "tabdo-jobs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "ProductSessionObject"
      },
      {
        "name": "EXECUTIONS",
        "class_name": "ProductExecutionObject"
      },
      {
        "name": "VALIDATORS",
        "class_name": "ProductValidationObject"
      }
    ]
  },
  "containers": [
    {
      "class_name": "ProductExecutionObject",
      "scheduling_policy": "durable_object",
      "images": {
        "runner": {
          "dockerfile": "sandbox/runtime/Dockerfile",
          "build_context": "../.."
        }
      }
    },
    {
      "class_name": "ProductValidationObject",
      "scheduling_policy": "durable_object",
      "images": {
        "runner": {
          "dockerfile": "sandbox/runtime/Dockerfile",
          "build_context": "../.."
        }
      }
    }
  ],
  "exports": {
    "ProductSessionObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ProductExecutionObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ProductValidationObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.md",
        "**/*.py"
      ],
      "fallthrough": true
    }
  ],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "INTEGRATION_ENCRYPTION_KEY"
    ]
  }
}
