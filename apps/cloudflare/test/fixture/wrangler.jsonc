{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tabdo-session-coordination-fixture",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "FixtureSessionCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FixtureSessionCoordinator"] }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000", "localConnectionString": "postgresql://tableapp:tableapp@127.0.0.1:5432/tabdo_agent_test" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "tabdo-coordination-fixture" }],
    "consumers": [{ "queue": "tabdo-coordination-fixture", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "retry_delay": 1 }]
  },
  "vars": { "INTERNAL_SECRET": "fixture-only-internal-signing-secret-not-production" },
  "triggers": { "crons": ["* * * * *"] }
}
