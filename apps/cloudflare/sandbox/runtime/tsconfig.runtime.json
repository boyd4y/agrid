{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@tabdo/agent-runtime/*": ["../../../../packages/agent-runtime/src/*"],
      "@tabdo/platform-node/*": ["../../../../packages/platform-node/src/*"],
      "@ai-sdk/harness": ["../../../../packages/agent-runtime/node_modules/@ai-sdk/harness/dist/index.js"],
      "@ai-sdk/harness/*": ["../../../../packages/agent-runtime/node_modules/@ai-sdk/harness/dist/*/index.js"],
      "ai": ["../../../../packages/agent-runtime/node_modules/ai/dist/index.js"],
      "zod": ["../../../../packages/backend/node_modules/zod/index.js"]
    }
  },
  "include": ["entry.ts", "execute.ts"]
}
