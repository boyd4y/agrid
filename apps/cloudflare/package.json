{
  "name": "@tabdo/cloudflare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./coordinator": {
      "types": "./dist/coordinator.d.ts",
      "import": "./dist/coordinator.js"
    },
    "./triggers": {
      "types": "./dist/triggers.d.ts",
      "import": "./dist/triggers.js"
    },
    "./internal-auth": {
      "types": "./dist/internal-auth.d.ts",
      "import": "./dist/internal-auth.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "types:fixture": "wrangler types test/fixture/env.d.ts --config test/fixture/wrangler.jsonc --env-interface CoordinationTestEnv --include-runtime=false",
    "build:fixture": "wrangler deploy --dry-run --config test/fixture/wrangler.jsonc --outdir dist/fixture",
    "test:sandbox": "tsx --test sandbox/local.test.ts",
    "typecheck:sandbox": "tsc -p sandbox/tsconfig.node.json && tsc -p sandbox/tsconfig.worker.json",
    "types:sandbox": "wrangler types sandbox/fixture/env.d.ts --config sandbox/fixture/wrangler.jsonc --env-interface NativeSandboxFixtureEnv --include-runtime=false",
    "dev": "wrangler dev --local",
    "types": "wrangler types src/env.d.ts --config wrangler.jsonc --env-interface Env --include-runtime=false",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "test:product": "tsx --test --test-concurrency=1 sandbox/product-live.test.ts sandbox/automation-live.test.ts sandbox/streaming-live.test.ts",
    "typecheck:product": "tsc -p sandbox/tsconfig.product.json",
    "build:product": "wrangler deploy --dry-run --config wrangler.jsonc"
  },
  "dependencies": {
    "@tabdo/core": "workspace:*",
    "@tabdo/platform-cloudflare": "workspace:*",
    "@tabdo/backend": "workspace:*",
    "@tabdo/shared": "workspace:*",
    "hono": "^4.7.8",
    "zod": "^4.6.5",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "^22.14.1",
    "ai": "7.0.138",
    "postgres": "^3.4.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "wrangler": "4.149.0"
  }
}
