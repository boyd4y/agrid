# Copy to .env.production for explicit local production commands, or set Railway variables.
# pnpm dev does not read this file. Never commit real credentials.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@NEON-POOLED-HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@NEON-DIRECT-HOST/neondb?sslmode=require
REDIS_URL=redis://USER:PASSWORD@REDIS-HOST:6379
QUEUE_PREFIX=tabdo-production
PORT=3001
HOST=0.0.0.0
APP_URL=https://YOUR-DOMAIN
BETTER_AUTH_URL=https://YOUR-DOMAIN
SITE_SDK_URL=https://cdn.jsdelivr.net/npm/@tabdo/sdk@0.1.1/dist/tabdo.js
BETTER_AUTH_SECRET=REPLACE-WITH-A-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
AUTH_REQUIRED=true
INTEGRATION_ENCRYPTION_KEY=REPLACE-WITH-32-RANDOM-BYTES-BASE64
FILE_STORAGE_DRIVER=s3
FILE_STORAGE_S3_ENDPOINT=https://YOUR-S3-ENDPOINT
FILE_STORAGE_S3_REGION=us-east-1
FILE_STORAGE_S3_BUCKET=tabdo-files
FILE_STORAGE_S3_ACCESS_KEY_ID=
FILE_STORAGE_S3_SECRET_ACCESS_KEY=
PI_API_KEY=
PI_BASE_URL=https://api.deepseek.com/v1
PI_MODEL=
# Configure native Harness/Sandbox providers as needed; see .env.example.
# pnpm db:migrate:prod: migration using the direct database endpoint.
# pnpm start / pnpm start:worker: run the built API / worker.
